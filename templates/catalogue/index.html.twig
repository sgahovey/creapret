{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="page-header">
            <div>
                <h1 class="page-header__titre h3"><i class="bi bi-grid me-2" aria-hidden="true"></i>Catalogue du matériel</h1>
                <p class="page-header__soustitre">Parcourez le matériel proposé au prêt et vérifiez sa disponibilité.</p>
            </div>
        </div>

        <nav class="mb-4" aria-label="Filtrer par catégorie">
            <div class="btn-group flex-wrap" role="group" aria-label="Catégories">
                <a href="{{ path('app_catalogue_index') }}"
                   class="btn btn-sm {{ categorieActive is null ? 'btn-primary' : 'btn-outline-primary' }}">Toutes</a>
                {% for categorie in categories %}
                    <a href="{{ path('app_catalogue_index', {categorie: categorie.id}) }}"
                       class="btn btn-sm {{ categorieActive == categorie.id ? 'btn-primary' : 'btn-outline-primary' }}">{{ categorie.nom }}</a>
                {% endfor %}
            </div>
        </nav>

        <div class="row g-4">
        {% for ligne in catalogue %}
            <div class="col-sm-6 col-lg-4">
                <div class="cp-card h-100">
                    <div class="cp-card__corps">
                        <h2 class="h5"><a href="{{ path('app_catalogue_show', {id: ligne.materiel.id}) }}" class="text-decoration-none">{{ ligne.materiel.nom }}</a></h2>
                        <p class="text-muted mb-2">{{ ligne.materiel.categorie.nom }}</p>
                        {% if ligne.materiel.marque %}
                            <p class="mb-3">{{ ligne.materiel.marque }}{% if ligne.materiel.modele %} - {{ ligne.materiel.modele }}{% endif %}</p>
                        {% endif %}
                        {% if ligne.nbDisponibles > 0 %}
                            <span class="badge text-bg-success">{{ ligne.nbDisponibles }} disponible{{ ligne.nbDisponibles > 1 ? 's' : '' }}</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Aucun disponible actuellement</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="empty-state">
                    <i class="bi bi-inbox empty-state__icone" aria-hidden="true"></i>
                    <p>Aucun matériel dans cette catégorie pour le moment.</p>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
{% endblock %}
