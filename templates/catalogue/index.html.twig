{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}
    <div class="container py-5">
        <h1 class="mb-4">Catalogue du matériel</h1>

        <nav class="mb-4" aria-label="Filtrer par catégorie">
            <a href="{{ path('app_catalogue_index') }}"
               class="btn btn-sm {{ categorieActive is null ? 'btn-primary' : 'btn-outline-primary' }}">Toutes</a>
            {% for categorie in categories %}
                <a href="{{ path('app_catalogue_index', {categorie: categorie.id}) }}"
                   class="btn btn-sm {{ categorieActive == categorie.id ? 'btn-primary' : 'btn-outline-primary' }}">{{ categorie.nom }}</a>
            {% endfor %}
        </nav>

        <div class="row g-4">
        {% for ligne in catalogue %}
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 card-title"><a href="{{ path('app_catalogue_show', {id: ligne.materiel.id}) }}">{{ ligne.materiel.nom }}</a></h2>
                        <p class="card-subtitle text-muted mb-2">{{ ligne.materiel.categorie.nom }}</p>
                        {% if ligne.materiel.marque %}
                            <p class="card-text mb-2">{{ ligne.materiel.marque }}{% if ligne.materiel.modele %} - {{ ligne.materiel.modele }}{% endif %}</p>
                        {% endif %}
                        {% if ligne.nbDisponibles > 0 %}
                            <span class="badge text-bg-success">{{ ligne.nbDisponibles }} disponible{{ ligne.nbDisponibles > 1 ? 's' : '' }}</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Aucun disponible actuellement</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun matériel dans cette catégorie pour le moment.</p>
        {% endfor %}
        </div>
    </div>
{% endblock %}
