{% extends 'base.html.twig' %}

{% block title %}{{ materiel.nom }}{% endblock %}

{% block body %}
    <main class="container py-5" style="max-width: 48rem;">
        <nav aria-label="fil d'ariane" class="mb-3">
            <a href="{{ path('app_catalogue_index') }}">&larr; Retour au catalogue</a>
        </nav>

        <h1 class="mb-2">{{ materiel.nom }}</h1>
        <p class="text-muted">{{ materiel.categorie.nom }}</p>

        {% if nbDisponibles > 0 %}
            <p><span class="badge text-bg-success">{{ nbDisponibles }} exemplaire{{ nbDisponibles > 1 ? 's' : '' }} disponible{{ nbDisponibles > 1 ? 's' : '' }} actuellement</span></p>
        {% else %}
            <p><span class="badge text-bg-secondary">Aucun exemplaire disponible actuellement</span></p>
        {% endif %}

        <dl class="row mt-4">
            {% if materiel.description %}
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">{{ materiel.description }}</dd>
            {% endif %}
            {% if materiel.marque %}
                <dt class="col-sm-3">Marque</dt>
                <dd class="col-sm-9">{{ materiel.marque }}</dd>
            {% endif %}
            {% if materiel.modele %}
                <dt class="col-sm-3">Modele</dt>
                <dd class="col-sm-9">{{ materiel.modele }}</dd>
            {% endif %}
            {% if materiel.reference %}
                <dt class="col-sm-3">Reference</dt>
                <dd class="col-sm-9">{{ materiel.reference }}</dd>
            {% endif %}
        </dl>

        <section class="mt-4" aria-labelledby="titre-dispo">
            <h2 id="titre-dispo" class="h5">Disponibilite sur une periode</h2>
            <form method="get" action="{{ path('app_catalogue_show', {id: materiel.id}) }}" class="row g-2 align-items-end">
                <div class="col-auto">
                    <label for="debut" class="form-label">Du</label>
                    <input type="date" id="debut" name="debut" value="{{ debut }}" class="form-control" required>
                </div>
                <div class="col-auto">
                    <label for="fin" class="form-label">Au</label>
                    <input type="date" id="fin" name="fin" value="{{ fin }}" class="form-control" required>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-primary">Verifier la disponibilite</button>
                </div>
            </form>

            {% if erreurPeriode %}
                <div class="alert alert-warning mt-3" role="alert">{{ erreurPeriode }}</div>
            {% elseif nbSurPeriode is not null %}
                <p class="mt-3">
                    {% if nbSurPeriode > 0 %}
                        <span class="badge text-bg-success">{{ nbSurPeriode }} exemplaire{{ nbSurPeriode > 1 ? 's' : '' }} disponible{{ nbSurPeriode > 1 ? 's' : '' }} sur cette periode</span>
                    {% else %}
                        <span class="badge text-bg-secondary">Aucun exemplaire disponible sur cette periode</span>
                    {% endif %}
                </p>
            {% endif %}

            {% if formDemande is defined and formDemande is not null %}
                <div class="mt-3 border-top pt-3">
                    <h3 class="h6">Demander un pret sur cette periode</h3>
                    {{ form_start(formDemande) }}
                    {{ form_widget(formDemande) }}
                    <button type="submit" class="btn btn-primary mt-2">Demander un pret</button>
                    {{ form_end(formDemande) }}
                </div>
            {% endif %}
        </section>

        {# Iteration 3 (CU-04) : le bouton « Demander un pret » prendra place ici,
           conditionne a la disponibilite sur la periode choisie (RG-4). #}
    </main>
{% endblock %}
