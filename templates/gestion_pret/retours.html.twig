{% extends 'base.html.twig' %}

{% block title %}Prêts en cours - retours{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="page-header">
            <div>
                <h1 class="page-header__titre h3">Prêts en cours</h1>
                <p class="page-header__soustitre">Enregistrez le retour des prêts validés, avec ou sans dommage.</p>
            </div>
            <a href="{{ path('app_gestion_prets') }}" class="btn btn-outline-primary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Demandes en attente</a>
        </div>

        {% if prets is empty %}
            <div class="empty-state">
                <i class="bi bi-inbox empty-state__icone" aria-hidden="true"></i>
                <p>Aucun prêt en cours.</p>
            </div>
        {% else %}
            <div class="cp-card">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Emprunteur</th>
                                <th scope="col">Matériel</th>
                                <th scope="col">Exemplaire</th>
                                <th scope="col">Période</th>
                                <th scope="col">Retour</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for pret in prets %}
                                <tr>
                                    <td>{{ pret.emprunteur.prenom }} {{ pret.emprunteur.nom }}</td>
                                    <td>{{ pret.exemplaire.materiel.nom }}</td>
                                    <td>{{ pret.exemplaire.numeroInventaire }}</td>
                                    <td>{{ pret.dateDebut|date('d/m/Y') }} au {{ pret.dateFin|date('d/m/Y') }}{% if pret.estEnRetard(maintenant) %} <span class="badge text-bg-danger ms-2">{{ pret.joursDeRetard(maintenant) }} jour(s) de retard</span>{% endif %}</td>
                                    <td>
                                        <form method="post" action="{{ path('app_gestion_pret_retour', {id: pret.id}) }}" class="d-flex align-items-center gap-2">
                                            <input type="hidden" name="_token" value="{{ csrf_token('retour' ~ pret.id) }}">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="dommage" value="1" id="dommage-{{ pret.id }}">
                                                <label class="form-check-label" for="dommage-{{ pret.id }}">Matériel endommagé</label>
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-sm">Enregistrer le retour</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
