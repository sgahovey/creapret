{% extends 'emails/_layout.html.twig' %}
{% block titre %}Votre pret arrive a echeance{% endblock %}
{% block contenu %}
    <p>Bonjour {{ pret.emprunteur.prenom }},</p>
    <p>Nous vous rappelons que votre pret doit etre retourne <strong>demain</strong>.</p>
    <p>
        <strong>Materiel :</strong> {{ pret.exemplaire.materiel.nom }} (exemplaire {{ pret.exemplaire.numeroInventaire }})<br>
        <strong>A retourner le :</strong> {{ pret.dateFin|date('d/m/Y') }}
    </p>
    <div style="margin-top:24px;">
        <a href="{{ lien }}" style="display:inline-block; background-color:#0f6e56; color:#ffffff; text-decoration:none; padding:12px 24px; border-radius:6px; font-weight:bold;">Voir mes prets</a>
    </div>
    <p style="margin-top:16px; font-size:13px; color:#777777;">Vous recevez ce rappel car vous avez active les rappels d'echeance. Vous pouvez les desactiver dans votre profil.</p>
{% endblock %}
