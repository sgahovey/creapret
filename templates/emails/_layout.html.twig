<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block titre_page %}CréaPrêt{% endblock %}</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f4f4; font-family:Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4; padding:24px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; overflow:hidden; max-width:600px; width:100%;">
                    {% if app_environment_label is defined and app_environment_label != 'prod' and app_environment_label != '' %}
                    <tr>
                        <td style="background-color:#c2410c; color:#ffffff; text-align:center; padding:8px 12px; font-size:12px; font-weight:bold; letter-spacing:1px;">
                            ENVIRONNEMENT {{ app_environment_label|upper }} - EMAIL DE TEST, NE PAS DIFFUSER
                        </td>
                    </tr>
                    {% endif %}
                    <tr>
                        <td style="background-color:#0f6e56; color:#ffffff; padding:20px 24px;">
                            <span style="font-size:20px; font-weight:bold;">CréaPrêt</span>
                            <span style="font-size:13px; color:#d1e7e0;"> - prêt de matériel</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:24px;">
                            <h1 style="margin:0 0 4px; font-size:20px; color:#1a1a1a;">{% block titre %}{% endblock %}</h1>
                            {% block sous_titre %}{% endblock %}
                            <div style="margin-top:16px; font-size:15px; color:#333333; line-height:1.6;">
                                {% block contenu %}{% endblock %}
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="background-color:#f0f0f0; padding:16px 24px; font-size:12px; color:#777777; text-align:center;">
                            CréaPrêt - Cnam La Réunion<br>
                            Cet email vous est adressé dans le cadre du service de prêt de matériel.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
