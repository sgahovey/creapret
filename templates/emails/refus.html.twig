{% extends 'emails/_layout.html.twig' %}
{% block titre %}Votre demande de pret a ete refusee{% endblock %}
{% block contenu %}
    <p>Bonjour {{ pret.emprunteur.prenom }},</p>
    <p>Votre demande de pret n'a pas pu etre acceptee.</p>
    <p>
        <strong>Materiel :</strong> {{ pret.exemplaire.materiel.nom }}<br>
        <strong>Periode demandee :</strong> {{ pret.dateDebut|date('d/m/Y') }} au {{ pret.dateFin|date('d/m/Y') }}
    </p>
    {% if pret.motifRefus is not null %}
        <p style="background-color:#fef2f2; border-left:4px solid #dc2626; padding:12px 16px;">
            <strong>Motif :</strong> {{ pret.motifRefus }}
        </p>
    {% endif %}
    <div style="margin-top:24px;">
        <a href="{{ lien }}" style="display:inline-block; background-color:#0f6e56; color:#ffffff; text-decoration:none; padding:12px 24px; border-radius:6px; font-weight:bold;">Voir mes prets</a>
    </div>
{% endblock %}
