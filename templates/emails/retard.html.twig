{% extends 'emails/_layout.html.twig' %}
{% block titre %}Votre pret est en retard{% endblock %}
{% block contenu %}
    <p>Bonjour {{ pret.emprunteur.prenom }},</p>
    <p style="background-color:#fef2f2; border-left:4px solid #dc2626; padding:12px 16px;">
        Votre pret devait etre retourne le <strong>{{ pret.dateFin|date('d/m/Y') }}</strong> et n'a pas encore ete rendu.
    </p>
    <p>
        <strong>Materiel :</strong> {{ pret.exemplaire.materiel.nom }} (exemplaire {{ pret.exemplaire.numeroInventaire }})
    </p>
    <p>Merci de proceder au retour dans les meilleurs delais afin de permettre a d'autres utilisateurs d'emprunter ce materiel.</p>
    <div style="margin-top:24px;">
        <a href="{{ lien }}" style="display:inline-block; background-color:#0f6e56; color:#ffffff; text-decoration:none; padding:12px 24px; border-radius:6px; font-weight:bold;">Voir mes prets</a>
    </div>
{% endblock %}
