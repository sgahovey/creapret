{% extends 'base.html.twig' %}

{% block title %}Comptes{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="page-header">
            <div>
                <h1 class="page-header__titre h3">Comptes</h1>
                <p class="page-header__soustitre">Gérez les comptes utilisateurs, leurs rôles et leur activation.</p>
            </div>
            <a href="{{ path('app_admin_compte_nouveau') }}" class="btn btn-primary"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Nouveau compte</a>
        </div>

        <form method="get" action="{{ path('app_admin_comptes') }}" class="row g-2 align-items-end mb-4">
            <div class="col-auto">
                <label for="recherche" class="form-label">Rechercher</label>
                <input type="search" id="recherche" name="recherche" value="{{ recherche }}" class="form-control" placeholder="Nom, prénom ou e-mail">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Rechercher</button>
            </div>
        </form>

        {% if comptes is empty %}
            <div class="empty-state">
                <i class="bi bi-people empty-state__icone" aria-hidden="true"></i>
                <p>Aucun compte{% if recherche %} pour cette recherche{% endif %}.</p>
            </div>
        {% else %}
            <div class="cp-card">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Nom</th>
                                <th scope="col">E-mail</th>
                                <th scope="col">Rôle</th>
                                <th scope="col">État</th>
                                <th scope="col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for compte in comptes %}
                                {% set attributActivation = compte.estActif ? 'DESACTIVER' : 'ACTIVER' %}
                                <tr>
                                    <td>{{ compte.prenom }} {{ compte.nom }}</td>
                                    <td>{{ compte.email }}</td>
                                    <td><span class="badge text-bg-{{ compte.role.couleurBadge }}">{{ compte.role.libelle }}</span></td>
                                    <td>
                                        {% if compte.estActif %}
                                            <span class="badge text-bg-success">Actif</span>
                                        {% else %}
                                            <span class="badge text-bg-secondary">Inactif</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('app_admin_compte_modifier', {id: compte.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                                        {% if is_granted(attributActivation, compte) %}
                                            <form method="post" action="{{ path('app_admin_compte_activation', {id: compte.id}) }}" class="d-inline"
                                                  data-controller="confirmer" data-action="submit->confirmer#demander" data-confirmer-message-value="{{ compte.estActif ? 'Désactiver' : 'Réactiver' }} ce compte ?">
                                                <input type="hidden" name="_token" value="{{ csrf_token('activation' ~ compte.id) }}">
                                                <button type="submit" class="btn btn-sm {{ compte.estActif ? 'btn-outline-danger' : 'btn-outline-success' }}">{{ compte.estActif ? 'Désactiver' : 'Réactiver' }}</button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {% if nbPages > 1 %}
                {% set parametresFiltre = recherche ? {recherche: recherche} : {} %}
                <nav aria-label="Pagination des comptes" class="mt-3">
                    <ul class="pagination">
                        <li class="page-item{{ page <= 1 ? ' disabled' : '' }}">
                            <a class="page-link" href="{{ path('app_admin_comptes', parametresFiltre|merge({page: page - 1})) }}">Précédent</a>
                        </li>
                        <li class="page-item disabled"><span class="page-link">Page {{ page }} / {{ nbPages }}</span></li>
                        <li class="page-item{{ page >= nbPages ? ' disabled' : '' }}">
                            <a class="page-link" href="{{ path('app_admin_comptes', parametresFiltre|merge({page: page + 1})) }}">Suivant</a>
                        </li>
                    </ul>
                </nav>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
