{% extends 'base.html.twig' %}

{% block title %}Nouveau compte{% endblock %}

{% form_theme formulaire 'bootstrap_5_layout.html.twig' %}

{% block body %}
    <div class="container py-5">
        <div class="page-header">
            <div>
                <h1 class="page-header__titre h3">Nouveau compte</h1>
                <p class="page-header__soustitre">Créez un compte et attribuez-lui un rôle.</p>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="cp-card">
                    <div class="cp-card__corps">
                        {{ form_start(formulaire) }}
                            {{ form_row(formulaire.email) }}
                            {{ form_row(formulaire.prenom) }}
                            {{ form_row(formulaire.nom) }}
                            {{ form_row(formulaire.role) }}
                            {{ form_row(formulaire.estActif) }}
                            {{ form_row(formulaire.emailRappel) }}
                            {{ form_row(formulaire.plainPassword) }}
                            <div class="d-flex gap-2 mt-3">
                                <button type="submit" class="btn btn-primary">Créer le compte</button>
                                <a href="{{ path('app_admin_comptes') }}" class="btn btn-link">Annuler</a>
                            </div>
                        {{ form_end(formulaire) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
