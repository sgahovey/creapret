{% extends 'base.html.twig' %}

{% block title %}Journal d'administration{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="page-header">
            <div>
                <h1 class="page-header__titre h3">Journal d'administration</h1>
                <p class="page-header__soustitre">Traçabilité des décisions de gestion (validations, refus, retours).</p>
            </div>
        </div>

        <div class="cp-card">
            <div class="cp-card__corps">
                <form method="get" action="{{ path('app_admin_journal') }}" class="row g-2 align-items-end" data-controller="auto-soumettre">
                    <div class="col-auto">
                        <label for="type" class="form-label">Filtrer par action</label>
                        <select name="type" id="type" class="form-select form-select-sm" data-action="change->auto-soumettre#soumettre">
                            <option value="">Toutes les actions</option>
                            {% for typeAction in typesDisponibles %}
                                <option value="{{ typeAction.value }}"{{ typeSelectionne == typeAction ? ' selected' : '' }}>
                                    {{ typeAction.libelle }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-secondary" data-auto-soumettre-target="bouton">Filtrer</button>
                    </div>
                </form>
                <p class="text-muted small mt-2 mb-0">{{ total }} entrée(s) au total.</p>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <caption class="visually-hidden">Journal des actions d'administration, de la plus récente à la plus ancienne</caption>
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Acteur</th>
                            <th scope="col">Action</th>
                            <th scope="col">Cible</th>
                            <th scope="col">Détails</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entree in entrees %}
                            <tr>
                                <td>{{ entree.dateAction|date('d/m/Y H\\hi', 'Indian/Reunion') }}</td>
                                <td>{{ entree.acteurLibelle }}</td>
                                <td><span class="badge text-bg-light">{{ entree.typeAction.libelle }}</span></td>
                                <td>{{ entree.cibleLibelle ?? '—' }}</td>
                                <td>{{ entree.details ?? '—' }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox empty-state__icone" aria-hidden="true"></i>
                                        <p>Aucune entrée.</p>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if nbPages > 1 %}
            {% set parametresFiltre = typeSelectionne ? {type: typeSelectionne.value} : {} %}
            <nav aria-label="Pagination du journal" class="mt-3">
                <ul class="pagination">
                    <li class="page-item{{ page <= 1 ? ' disabled' : '' }}">
                        <a class="page-link" href="{{ path('app_admin_journal', parametresFiltre|merge({page: page - 1})) }}">Précédent</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">Page {{ page }} / {{ nbPages }}</span>
                    </li>
                    <li class="page-item{{ page >= nbPages ? ' disabled' : '' }}">
                        <a class="page-link" href="{{ path('app_admin_journal', parametresFiltre|merge({page: page + 1})) }}">Suivant</a>
                    </li>
                </ul>
            </nav>
        {% endif %}
    </div>
{% endblock %}
