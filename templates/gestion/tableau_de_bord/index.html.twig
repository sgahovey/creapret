{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Chart.js charge uniquement sur cette page (sobriete RGESN). #}
    <script src="{{ asset('vendor/chartjs/chart.umd.min.js') }}"></script>
{% endblock %}

{% block body %}
<div class="container my-4">
    <h1 class="mb-4">Tableau de bord</h1>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card text-bg-light h-100">
                <div class="card-body">
                    <div class="text-muted small">Prets en cours</div>
                    <div class="display-6">{{ stats.pretsEnCours }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card text-bg-light h-100">
                <div class="card-body">
                    <div class="text-muted small">Demandes en attente</div>
                    <div class="display-6">{{ stats.demandesEnAttente }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 {{ stats.pretsEnRetard > 0 ? 'text-bg-danger' : 'text-bg-light' }}">
                <div class="card-body">
                    <div class="small {{ stats.pretsEnRetard > 0 ? '' : 'text-muted' }}">Prets en retard</div>
                    <div class="display-6">{{ stats.pretsEnRetard }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card text-bg-light h-100">
                <div class="card-body">
                    <div class="text-muted small">Taux d'occupation</div>
                    <div class="display-6">{{ stats.tauxOccupation }} %</div>
                    <div class="text-muted small">{{ stats.exemplairesEngages }} / {{ stats.exemplairesTotal }} exemplaires</div>
                </div>
            </div>
        </div>
    </div>

    <section class="card"
             data-controller="graphique-materiels"
             data-graphique-materiels-series-value="{{ stats.topMateriels|json_encode|e('html_attr') }}">
        <div class="card-body">
            <h2 class="h5">Top 5 des materiels les plus empruntes</h2>

            {% if stats.topMateriels is empty %}
                <p class="text-muted">Aucun prêt enregistre pour le moment.</p>
            {% else %}
                <div style="position:relative; height:320px;">
                    <canvas data-graphique-materiels-target="canvas"
                            role="img"
                            aria-label="Diagramme en barres des materiels les plus empruntes. Le detail chiffre figure dans le tableau ci-dessous."></canvas>
                </div>

                <details class="mt-3">
                    <summary>Voir les donnees</summary>
                    <table class="table table-sm mt-2">
                        <caption class="visually-hidden">Nombre de prets par materiel</caption>
                        <thead>
                            <tr>
                                <th scope="col">Materiel</th>
                                <th scope="col">Nombre de prets</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ligne in stats.topMateriels %}
                                <tr>
                                    <td>{{ ligne.materiel }}</td>
                                    <td>{{ ligne.total }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </details>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}
