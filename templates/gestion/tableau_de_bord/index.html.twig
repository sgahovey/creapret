{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Chart.js charge uniquement sur cette page (sobriete RGESN). #}
    <script src="{{ asset('vendor/chartjs/chart.umd.min.js') }}"></script>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="page-header">
        <div>
            <h1 class="page-header__titre h3">Tableau de bord</h1>
            <p class="page-header__soustitre">Vue d'ensemble de l'activité de prêt du parc.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="cp-card h-100">
                <div class="cp-card__corps">
                    <div class="text-muted small"><i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i>Prêts en cours</div>
                    <div class="display-6 fw-semibold">{{ stats.pretsEnCours }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="cp-card h-100">
                <div class="cp-card__corps">
                    <div class="text-muted small"><i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>Demandes en attente</div>
                    <div class="display-6 fw-semibold">{{ stats.demandesEnAttente }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="h-100 {{ stats.pretsEnRetard > 0 ? 'card text-bg-danger' : 'cp-card' }}">
                <div class="cp-card__corps">
                    <div class="small {{ stats.pretsEnRetard > 0 ? '' : 'text-muted' }}"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>Prêts en retard</div>
                    <div class="display-6 fw-semibold">{{ stats.pretsEnRetard }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="cp-card h-100">
                <div class="cp-card__corps">
                    <div class="text-muted small"><i class="bi bi-pie-chart me-1" aria-hidden="true"></i>Taux d'occupation</div>
                    <div class="display-6 fw-semibold">{{ stats.tauxOccupation }} %</div>
                    <div class="text-muted small">{{ stats.exemplairesEngages }} / {{ stats.exemplairesTotal }} exemplaires</div>
                </div>
            </div>
        </div>
    </div>

    <section class="cp-card"
             data-controller="graphique-materiels"
             data-graphique-materiels-series-value="{{ stats.topMateriels|json_encode|e('html_attr') }}">
        <div class="cp-card__corps">
            <h2 class="h5">Top 5 des matériels les plus empruntés</h2>

            {% if stats.topMateriels is empty %}
                <p class="text-muted">Aucun prêt enregistré pour le moment.</p>
            {% else %}
                <div style="position:relative; height:320px;">
                    <canvas data-graphique-materiels-target="canvas"
                            role="img"
                            aria-label="Diagramme en barres des matériels les plus empruntés. Le détail chiffré figure dans le tableau ci-dessous."></canvas>
                </div>

                <details class="mt-3">
                    <summary>Voir les données</summary>
                    <table class="table table-sm mt-2">
                        <caption class="visually-hidden">Nombre de prêts par matériel</caption>
                        <thead>
                            <tr>
                                <th scope="col">Matériel</th>
                                <th scope="col">Nombre de prêts</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ligne in stats.topMateriels %}
                                <tr>
                                    <td>{{ ligne.materiel }}</td>
                                    <td>{{ ligne.total }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </details>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}
