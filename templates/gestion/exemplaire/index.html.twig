{% extends 'base.html.twig' %}

{% block title %}Exemplaires{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="page-header">
            <div>
                <h1 class="page-header__titre h3">Exemplaires</h1>
                <p class="page-header__soustitre">Gérez les exemplaires physiques et leur état (disponible, maintenance, hors service...).</p>
            </div>
            <a href="{{ path('app_exemplaire_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nouvel exemplaire</a>
        </div>

        <div class="cp-card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Numéro d'inventaire</th>
                            <th scope="col">Matériel</th>
                            <th scope="col">État</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for exemplaire in exemplaires %}
                        <tr>
                            <td>{{ exemplaire.numeroInventaire }}</td>
                            <td>{{ exemplaire.materiel.nom }}</td>
                            <td><span class="badge text-bg-{{ exemplaire.etat.couleurBadge }}">{{ exemplaire.etat.libelle }}</span></td>
                            <td class="text-end">
                                <a href="{{ path('app_exemplaire_edit', {id: exemplaire.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                                <form method="post" action="{{ path('app_exemplaire_delete', {id: exemplaire.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Supprimer cet exemplaire ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('supprimer_exemplaire_' ~ exemplaire.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">
                                <div class="empty-state">
                                    <i class="bi bi-inbox empty-state__icone" aria-hidden="true"></i>
                                    <p>Aucun exemplaire pour le moment.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <a href="{{ path('app_gestion') }}" class="btn btn-link px-0 mt-3"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour à l'espace gestion</a>
    </div>
{% endblock %}
