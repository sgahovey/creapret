{% extends 'base.html.twig' %}

{% block title %}Modifier le matériel{% endblock %}

{% block body %}
    <div class="container py-5" style="max-width: 40rem;">
        <h1 class="mb-4">Modifier le matériel</h1>

        {{ form_start(form) }}
            {{ form_row(form.nom, {attr: {class: 'form-control'}, label_attr: {class: 'form-label'}}) }}
            {{ form_row(form.categorie, {attr: {class: 'form-select'}, label_attr: {class: 'form-label'}}) }}
            {{ form_row(form.description, {attr: {class: 'form-control'}, label_attr: {class: 'form-label'}}) }}
            {{ form_row(form.marque, {attr: {class: 'form-control'}, label_attr: {class: 'form-label'}}) }}
            {{ form_row(form.modele, {attr: {class: 'form-control'}, label_attr: {class: 'form-label'}}) }}
            {{ form_row(form.reference, {attr: {class: 'form-control'}, label_attr: {class: 'form-label'}}) }}
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('app_materiel_index') }}" class="btn btn-link">Annuler</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
