{% extends 'base.html.twig' %}

{% block title %}Espace gestion{% endblock %}

{% block body %}
    <main class="container py-5">
        <h1 class="mb-4">Espace gestion</h1>
        <p class="lead">Bienvenue dans l'espace de gestion du parc de materiel.</p>

        <div class="row g-4 mt-2">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 card-title">Categories</h2>
                        <p class="card-text">Gerer les categories du catalogue (informatique, audiovisuel, mesure...).</p>
                        <a href="{{ path('app_categorie_index') }}" class="btn btn-primary">Gerer les categories</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 card-title">Materiels</h2>
                        <p class="card-text">Gerer les materiels du catalogue et leur rattachement aux categories.</p>
                        <a href="{{ path('app_materiel_index') }}" class="btn btn-primary">Gerer les materiels</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 card-title">Exemplaires</h2>
                        <p class="card-text">Gerer les exemplaires physiques et leur etat (disponible, maintenance, hors service...).</p>
                        <a href="{{ path('app_exemplaire_index') }}" class="btn btn-primary">Gerer les exemplaires</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 card-title">Etat du parc</h2>
                        <p class="card-text">Consulter le nombre d'exemplaires par etat, pour chaque materiel.</p>
                        <a href="{{ path('app_parc_index') }}" class="btn btn-primary">Voir l'etat du parc</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
