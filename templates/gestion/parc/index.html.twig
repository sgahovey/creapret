{% extends 'base.html.twig' %}

{% block title %}État du parc{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="page-header">
            <div>
                <h1 class="page-header__titre h3">État du parc</h1>
                <p class="page-header__soustitre">Répartition des exemplaires par matériel et par état.</p>
            </div>
        </div>

        <div class="cp-card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Matériel</th>
                            {% for etat in etats %}
                                <th scope="col" class="text-center">{{ etat.libelle }}</th>
                            {% endfor %}
                            <th scope="col" class="text-center">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for ligne in parc %}
                        <tr>
                            <th scope="row" class="fw-normal">{{ ligne.materiel.nom }}</th>
                            {% for etat in etats %}
                                <td class="text-center">
                                    {% set nb = ligne.etats[etat.value] %}
                                    {% if nb > 0 %}
                                        <span class="badge text-bg-{{ etat.couleurBadge }}">{{ nb }}</span>
                                    {% else %}
                                        <span class="text-muted">0</span>
                                    {% endif %}
                                </td>
                            {% endfor %}
                            <td class="text-center fw-semibold">{{ ligne.total }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ etats|length + 2 }}">
                                <div class="empty-state">
                                    <i class="bi bi-inbox empty-state__icone" aria-hidden="true"></i>
                                    <p>Aucun matériel pour le moment.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <a href="{{ path('app_gestion') }}" class="btn btn-link px-0 mt-3"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour à l'espace gestion</a>
    </div>
{% endblock %}
