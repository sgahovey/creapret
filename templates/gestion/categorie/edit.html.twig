{% extends 'base.html.twig' %}

{% block title %}Modifier la categorie{% endblock %}

{% block body %}
    <main class="container py-5" style="max-width: 40rem;">
        <h1 class="mb-4">Modifier la categorie</h1>

        {{ form_start(form) }}
            {{ form_row(form.nom, {attr: {class: 'form-control'}, label_attr: {class: 'form-label'}}) }}
            {{ form_row(form.description, {attr: {class: 'form-control'}, label_attr: {class: 'form-label'}}) }}
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('app_categorie_index') }}" class="btn btn-link">Annuler</a>
        {{ form_end(form) }}
    </main>
{% endblock %}
