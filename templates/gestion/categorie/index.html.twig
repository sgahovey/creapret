{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="page-header">
            <div>
                <h1 class="page-header__titre h3">Catégories</h1>
                <p class="page-header__soustitre">Gérez les catégories du catalogue (informatique, audiovisuel, mesure...).</p>
            </div>
            <a href="{{ path('app_categorie_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nouvelle catégorie</a>
        </div>

        <div class="cp-card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Nom</th>
                            <th scope="col">Description</th>
                            <th scope="col">Matériels</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for categorie in categories %}
                        <tr>
                            <td>{{ categorie.nom }}</td>
                            <td>{{ categorie.description ?? '-' }}</td>
                            <td>{{ categorie.materiels|length }}</td>
                            <td class="text-end">
                                <a href="{{ path('app_categorie_edit', {id: categorie.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                                <form method="post" action="{{ path('app_categorie_delete', {id: categorie.id}) }}" class="d-inline"
                                      data-controller="confirmer" data-action="submit->confirmer#demander" data-confirmer-message-value="Supprimer cette catégorie ?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('supprimer_categorie_' ~ categorie.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">
                                <div class="empty-state">
                                    <i class="bi bi-inbox empty-state__icone" aria-hidden="true"></i>
                                    <p>Aucune catégorie pour le moment.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <a href="{{ path('app_gestion') }}" class="btn btn-link px-0 mt-3"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour à l'espace gestion</a>
    </div>
{% endblock %}
