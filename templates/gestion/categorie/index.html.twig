{% extends 'base.html.twig' %}

{% block title %}Categories{% endblock %}

{% block body %}
    <main class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Categories</h1>
            <a href="{{ path('app_categorie_new') }}" class="btn btn-primary">Nouvelle categorie</a>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Nom</th>
                    <th scope="col">Description</th>
                    <th scope="col">Materiels</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
            {% for categorie in categories %}
                <tr>
                    <td>{{ categorie.nom }}</td>
                    <td>{{ categorie.description ?? '-' }}</td>
                    <td>{{ categorie.materiels|length }}</td>
                    <td class="text-end">
                        <a href="{{ path('app_categorie_edit', {id: categorie.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        <form method="post" action="{{ path('app_categorie_delete', {id: categorie.id}) }}" class="d-inline"
                              onsubmit="return confirm('Supprimer cette categorie ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('supprimer_categorie_' ~ categorie.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucune categorie pour le moment.</td></tr>
            {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('app_gestion') }}">Retour a l'espace gestion</a>
    </main>
{% endblock %}
