# ============================================================================
# .env.deploy.example — variables d'infrastructure de CreaPret (production)
# ============================================================================
# COPIER en .env.deploy.local (NON versionne) et RENSEIGNER chaque valeur.
# Charge par : docker compose -f compose.prod.yml --env-file .env.deploy.local <cmd>
# AUCUNE valeur ici : ce fichier ne documente que les cles attendues par le serveur.
# ----------------------------------------------------------------------------
#
# NB : APP_ENVIRONMENT_LABEL n'est PAS une variable a fournir ici. Elle est fixee PAR SERVICE
#      dans compose.prod.yml (preprod pour les services de preproduction, prod pour ceux de
#      production) : c'est l'identite deterministe de l'environnement, pas un reglage d'infra.
#      Ainsi la production n'affiche jamais le bandeau de developpement, ni la mention e-mail.
# ----------------------------------------------------------------------------

# --- Images GHCR (tags poses par le pipeline CI/CD = SHA du commit deploye) ---
PREPROD_IMAGE_TAG=
PROD_IMAGE_TAG=

# --- MySQL : mot de passe root + un mot de passe par base applicative ---
MYSQL_ROOT_PASSWORD=
MYSQL_PREPROD_PASSWORD=
MYSQL_PROD_PASSWORD=

# --- Secret applicatif Symfony (un par environnement) ---
APP_SECRET_PREPROD=
APP_SECRET_PROD=

# --- URL publique de chaque environnement (liens absolus des e-mails, generes aussi par le worker) ---
PREPROD_URL=
PROD_URL=

# --- Mailer transactionnel Brevo (DSN complet, SECRET ; partage preprod/prod) ---
MAILER_DSN=

# --- Expediteur des e-mails (depend du domaine de deploiement) ---
APP_NOTIFICATION_FROM=
APP_NOTIFICATION_REPLY_TO=

# --- Preproduction : redirection de securite des e-mails (vide = envoi reel, pas de redirection) ---
PREPROD_MAILER_REDIRECT_TO=

# --- Proxies de confiance (Caddy en facade) : requis pour HTTPS/HSTS et URLs correctes derriere le
#     proxy. Symfony lit SYMFONY_TRUSTED_PROXIES. Ex. reseaux prives Docker :
#     172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
TRUSTED_PROXIES=
