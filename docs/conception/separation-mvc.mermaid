flowchart TB
    U(["Utilisateur"])

    subgraph PRES["Présentation"]
        direction TB
        CTRL["Contrôleur<br/><i>reçoit, valide la forme,<br/>choisit la réponse</i>"]
        VUE["Vue<br/><i>met en forme<br/>ce qui est affiché</i>"]
    end

    SERV["Traitement métier<br/><i>applique les règles,<br/>garantit les invariants</i>"]
    DEPOT["Accès aux données<br/><i>traduit une intention<br/>en interrogation</i>"]
    MOD["Modèle<br/><i>porte les données et les<br/>comportements intrinsèques</i>"]
    STOCK[("Stockage")]

    U -->|"requête"| CTRL
    CTRL -->|"délègue"| SERV
    SERV -->|"sollicite"| DEPOT
    DEPOT -->|"interroge"| STOCK
    DEPOT -->|"produit"| MOD
    SERV -->|"transmet"| CTRL
    CTRL -->|"confie au rendu"| VUE
    VUE -.->|"lit sans modifier"| MOD
    VUE -->|"réponse"| U

    subgraph LEG["Légende"]
        direction LR
        M1[" "] -->|"trait plein : appel<br/>ou transmission"| M2[" "]
        M3[" "] -.->|"pointillé : lecture seule"| M4[" "]
        M5["Le modèle n'émet aucune flèche montante :<br/>il ne connaît ni la vue, ni le contrôleur, ni le traitement."]
    end

    classDef pres fill:#e8f2ef,stroke:#0f6e56,color:#14312a
    classDef metier fill:#0f6e56,stroke:#0b4f3e,color:#fff
    classDef donnees fill:#f7f7f5,stroke:#8a8a82,color:#2b2b28
    classDef acteur fill:#fff,stroke:#0f6e56,color:#14312a
    classDef leg fill:#fff,stroke:#bfbfbf,color:#595959

    class CTRL,VUE pres
    class SERV metier
    class DEPOT,MOD,STOCK donnees
    class U acteur
    class M1,M2,M3,M4,M5,LEG leg
