@startuml deploiement-conception
' =====================================================================
' CréaPrêt — Diagramme de déploiement (CONCEPTION)
' Désignations génériques : aucun produit, plateforme ni commande.
' Notation UML de déploiement : node / artifact / database + relations.
' =====================================================================
skinparam shadowing false
title Diagramme de déploiement (conception) — désignations génériques

node "Poste de l'utilisateur" as USER {
  artifact "Client de navigation" as NAV
}

node "Machine hébergeante (unique, partagée)" as HOST {

  node "Point d'entrée unique" as ENTRY

  node "Environnement de validation\n(accès restreint)" as VAL {
    artifact "Application (validation)" as APPVAL
  }

  node "Environnement de service\n(ouvert au public)" as SVC {
    artifact "Application (service)" as APPSVC
  }

  database "Espace de données\n(deux jeux cloisonnés)" as DATA

  node "Dispositif de surveillance" as MON
}

NAV --> ENTRY : <<flux chiffré>>
ENTRY --> APPVAL : <<achemine / accès restreint>>
ENTRY --> APPSVC : <<achemine / accès public>>
APPVAL --> DATA : <<lit / écrit>>
APPSVC --> DATA : <<lit / écrit>>
MON ..> APPSVC : <<surveille>>
MON ..> APPVAL : <<surveille>>

legend right
  | **Symbole** | **Signification** |
  | Nœud (node) | Unité d'hébergement ou d'exécution |
  | Artefact (artifact) | Élément logiciel déployé sur un nœud |
  | Base (database) | Espace de données persistant |
  | Nœud imbriqué | Environnement contenu dans la machine |
  | Flèche pleine (-->) | Communication / dépendance de déploiement |
  | Flèche pointillée (..>) | Observation, sans couplage fonctionnel |
  | <<stéréotype>> | Nature de la relation |
endlegend

@enduml
