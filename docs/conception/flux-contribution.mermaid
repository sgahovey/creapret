flowchart LR
    subgraph L1["Ligne de fonctionnalité"]
        direction TB
        F1["Développement<br/>d'un lot de travail"]
    end

    subgraph L2["Ligne d'intégration"]
        direction TB
        I1["Coexistence<br/>des lots achevés"]
    end

    subgraph L3["Ligne de validation"]
        direction TB
        V1["Version candidate"]
        V2["Livrable construit<br/><i>désigné par son empreinte</i>"]
        V3["Environnement<br/>de vérification"]
    end

    subgraph L4["Ligne de service"]
        direction TB
        S1["Version publiée"]
        S2["Environnement<br/>public"]
        S3["Étiquette de version<br/><i>désignation d'usage</i>"]
    end

    CTL{{"Contrôles automatiques<br/>style · analyse statique · tests"}}

    F1 -->|"intégration"| I1
    I1 -->|"promotion"| V1
    V1 --> V2
    V2 -->|"installation automatique"| V3
    V1 -->|"publication"| S1
    S1 --> S2
    S1 --> S3

    F1 -.-> CTL
    I1 -.-> CTL
    V1 -.-> CTL
    S1 -.-> CTL

    V2 -.->|"EXIGENCE : promouvoir<br/>ce livrable"| S2
    CTL -.->|"EXIGENCE : subordonner<br/>l'installation"| S2

    subgraph LEG["Légende"]
        direction TB
        G1["Trait plein : cheminement effectif d'une modification"]
        G2["Pointillé : déclenchement de contrôles"]
        G3["Pointillé libellé EXIGENCE : garantie conçue, non encore tenue"]
        G4["L'installation en service est déclenchée manuellement"]
    end

    classDef ligne fill:#e8f2ef,stroke:#0f6e56,color:#14312a
    classDef service fill:#0f6e56,stroke:#0b4f3e,color:#fff
    classDef controle fill:#fff4e6,stroke:#b06a00,color:#5a3600
    classDef leg fill:#fff,stroke:#bfbfbf,color:#595959

    class F1,I1,V1,V2,V3 ligne
    class S1,S2,S3 service
    class CTL controle
    class G1,G2,G3,G4,LEG leg
