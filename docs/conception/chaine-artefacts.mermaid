flowchart TB
    A1["1 · Expression des besoins<br/>BF, besoins non fonctionnels, périmètre"]
    A2["2 · Règles de gestion<br/>invariants métier"]
    A3["3 · Cas d'utilisation<br/>par acteur, fiches détaillées"]
    A4["4 · Maquettes et<br/>enchaînement des écrans"]
    A5["5 · Architecture<br/>en couches"]
    A6["6 · Modèle de données<br/>conceptuel, logique, physique"]
    A7["7 · Diagramme<br/>de classes"]
    A8["8 · Diagrammes de séquence<br/>des cas critiques"]
    A9["9 · Conception<br/>de la sécurité"]
    A10["10 · Conception du déploiement<br/>et de l'exploitation"]
    A11["11 · Stratégie de tests<br/>par niveaux"]

    A1 --> A2
    A1 --> A3
    A2 --> A3
    A3 --> A4
    A3 --> A5
    A3 --> A6
    A6 --> A7
    A5 --> A8
    A7 --> A8
    A2 --> A8
    A5 --> A9
    A6 --> A9
    A5 --> A10
    A2 --> A11
    A8 --> A11
    A4 --> A11

    subgraph LEG["Légende"]
        direction LR
        L1[" "] --> L2["A → B : B ne peut être élaboré<br/>qu'une fois A établi"]
    end

    classDef socle fill:#0f6e56,stroke:#0b4f3e,color:#fff
    classDef inter fill:#e8f2ef,stroke:#0f6e56,color:#14312a
    classDef aval fill:#f7f7f5,stroke:#8a8a82,color:#2b2b28
    classDef leg fill:#fff,stroke:#bfbfbf,color:#595959

    class A1,A2 socle
    class A3,A4,A5,A6,A7 inter
    class A8,A9,A10,A11 aval
    class L1,L2,LEG leg
