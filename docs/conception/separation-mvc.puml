@startuml separation-mvc
' Figure 2.4b - Separation modele / vue / controleur
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam ArrowColor #4A4A45
skinparam ArrowThickness 1.2
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #0F6E56
  FontColor #14312A
  BorderThickness 1.4
}
skinparam database {
  BackgroundColor #F7F7F5
  BorderColor #8A8A82
  FontColor #2B2B28
}
skinparam actor {
  BorderColor #0F6E56
  FontColor #14312A
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #BFBFBF
  FontColor #40403C
  FontSize 12
}

actor "Utilisateur" as U

rectangle "Présentation" as PRES #FBFDFC {
  rectangle "**Contrôleur**\nreçoit la requête, valide sa forme,\nchoisit la réponse" as CTRL #EDF5F2
  rectangle "**Vue**\nmet en forme\nce qui est affiché" as VUE #EDF5F2
}
rectangle "**Traitement métier**\napplique les règles de gestion,\ngarantit les invariants" as SERV #D6E9E2
rectangle "**Accès aux données**\ntraduit une intention métier\nen interrogation du stockage" as DEPOT #F7F7F5
rectangle "**Modèle**\nporte les données et les\ncomportements intrinsèques" as MOD #F7F7F5
database "Stockage" as STOCK

U -down-> CTRL : requête
CTRL -down-> SERV : délègue
SERV -down-> DEPOT : sollicite
DEPOT -down-> STOCK : interroge
DEPOT -right-> MOD : produit
SERV -up-> CTRL : transmet
CTRL -right-> VUE : confie au rendu
VUE ..> MOD : lit sans modifier
VUE -up-> U : réponse

legend bottom
  |= |= Lecture du schéma |
  | Trait plein | Appel ou transmission |
  | Trait pointillé | Lecture seule, sans modification |
  | <b>Point clé</b> | Le modèle n'émet aucune flèche montante : il ne connaît\nni la vue, ni le contrôleur, ni le traitement métier. |
endlegend
@enduml
