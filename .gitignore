###> symfony/asset-mapper ###
/public/assets/
# Contenu de assets/vendor ignore (importmap le regenere via importmap:install),
# MAIS on versionne les bundles vendorises a la main hors importmap (ex. FullCalendar,
# bundle global §10 non regenerable). Motif avec /* pour autoriser les exceptions !.
/assets/vendor/*
!/assets/vendor/fullcalendar/
!/assets/vendor/bootstrap/
/assets/vendor/bootstrap/*
!/assets/vendor/bootstrap/bootstrap.min.css
!/assets/vendor/bootstrap-icons/
!/assets/vendor/inter/
###< symfony/asset-mapper ###

